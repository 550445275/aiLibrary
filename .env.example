# 复制为 .env 后由 docker compose 加载（已加入 .gitignore，勿提交真实密码）

# MySQL root 密码（与下方应用数据源需一致，若使用 root 连接）
MYSQL_ROOT_PASSWORD=please_change_me

# Spring 数据源（与 application-docker 默认一致，主机名为 compose 服务 db）
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/library?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=please_change_me
